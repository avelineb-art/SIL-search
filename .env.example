# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# SQLite for local development (default). Point at a Postgres DSN in production.
SIL_DATABASE_URL=sqlite:///data/processed/sil_research.db

# --- Search provider ---
# Which SearchProvider implementation the discovery layer should use.
# "mock" (default, no credentials needed), "serpapi" (recommended), or
# "google_cse".
SIL_SEARCH_PROVIDER=mock

# SerpApi (https://serpapi.com) credentials. Required only when
# SIL_SEARCH_PROVIDER=serpapi. Free tier is 100 searches/MONTH (not per
# day) - set SIL_DAILY_QUERY_BUDGET accordingly if you're on it.
SERPAPI_API_KEY=
SERPAPI_GOOGLE_DOMAIN=google.com.au
SERPAPI_COUNTRY=au
SERPAPI_LANGUAGE=en

# Google Programmable Search (Custom Search JSON API) credentials.
# Required only when SIL_SEARCH_PROVIDER=google_cse.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Daily query budget for the free/paid tier of whichever provider you use.
SIL_DAILY_QUERY_BUDGET=100

# Number of days before a previously-run query can be repeated.
SIL_QUERY_FRESHNESS_DAYS=30

# --- ABN Lookup (used by `abn-verify`) ---
# Register for a free GUID at https://abr.business.gov.au/Tools/WebServices
ABN_LOOKUP_GUID=

# --- Crawler ---
SIL_CRAWLER_USER_AGENT="SILProviderResearchBot/0.1 (+mailto:research@example.org)"
SIL_CRAWL_DELAY_SECONDS=2.0
SIL_CRAWL_MAX_PAGES_PER_DOMAIN=25
SIL_CRAWL_CONCURRENCY=4
SIL_CRAWL_REQUEST_TIMEOUT_SECONDS=15

# --- Export ---
SIL_EXPORT_DIR=data/exports
